<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= data.title %>, <%= data.location %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
        integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <link rel="stylesheet" href="/css/navfoot.css">
    <link rel="stylesheet" href="/css/show.css">
    <link rel="stylesheet" href="/css/rating.css">
</head>

<body>
    <div class="header">
        <%- include("../includes/navbar") %>
    </div>
    <% if(error.length> 0) { %>
        <div class="error-msg">
            <h2>
                <%= error[0] %>
            </h2>
        </div>
        <% } %>
            <div class="container">
                <h2 class="heading"><b>
                        <%= data.title.toUpperCase()%>
                    </b></h2>
                <div class="card">
                    <div class="img-container">
                        <img src="<%= data.image.url %>" alt="<%= data.title %>">
                    </div>
                    <div class="card-content">
                        <h6 class="title">
                            Owner <%= data.owner.user %>
                        </h6>

                        <p class="description">
                            <%= data.description %>
                        </p>

                        <ul class="details">
                            <li class="price">₹ <%= data.price.toLocaleString("en-IN") %>
                            </li>

                            <li>📍 <%= data.location %>
                            </li>

                            <li>🌍 <%= data.country %>
                            </li>
                        </ul>
                        <%if(currentUser && currentUser.equals(data.owner)){%>
                            <div class="btns">
                                <a href="/listings/<%= data.id %>/edit" class="btn edit-btn">Edit</a>
                                <form method="post" action="/listings/<%= data.id %>?_method=DELETE" class="del-btn">
                                    <button class="btn delete-btn">Delete</button>
                                </form>
                            </div>
                            <%}%>
                    </div>
                </div>
            </div>

            <!-- map and review form container -->
            <section class="mid-of-page">
                <div id="map"></div>
                <%if(currentUser){%>
                    <div class="review-container">
                        <h3>Create a Review</h3>
                        <form action="/listings/<%=data.id%>/review" method="post" class="review-form">
                            <label for="point">Rating</label>
                            <fieldset class="starability-slot">
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1"
                                    checked aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing"></label>
                            </fieldset>
                            <label for="comment">Comment</label>
                            <textarea name="review[comment]" id="comment" required maxlength="500"></textarea>
                            <button>Add review</button>
                        </form>
                    </div>
                    <%}%>
            </section>


            <section class="create-and-show-review">
                <div class="review-section">
                    <%for (let review of data.review){%>
                        <div class="review-box">
                            <p class="review-item">Author: <%=review.author.user%>
                            </p>
                            <p class="review-item star">
                                <% for(let i=0; i < review.rating; i++) { %>⭐<% } %>
                            </p>
                            <p class="review-item">
                                <%=review.comment%>
                            </p>
                            <%if(currentUser && currentUser.equals(review.author._id)){%>
                                <form method="post"
                                    action="/listings/<%=data.id%>/review/<%=review.id%>?_method=DELETE">
                                    <button><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"
                                            viewBox="0 0 24 24" fill="currentColor">
                                            <path
                                                d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                                        </svg></button>
                                </form>
                                <%}%>
                        </div>
                        <%}%>

                </div>
            </section>
            <div class="footer">
                <%- include("../includes/footer") %>
            </div>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                crossorigin="anonymous"></script>
            <script>
                const lat = Number("<%= data.geometry.lat %>");
                const lng = Number("<%= data.geometry.lng %>");
                console.log(document.getElementById("map"));
                console.log(lat, lng);
                const map = L.map("map").setView([lat, lng], 13);
                //for street view
                const street = L.tileLayer(
                    "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    attribution: "&copy;created by Tushar shit",
                    maxZoom: 17
                });
                //for statellite view
                const satellite = L.tileLayer(
                    "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}", {
                    attribution: "&copy;created by Tushar shit",
                    maxZoom: 17
                });
                //default statellite view
                satellite.addTo(map);
                //switch to these views
                L.control.layers({
                    "Street Map": street,
                    "Satellite": satellite
                }).addTo(map);
                //marker on map
                L.marker([lat, lng])
                    .addTo(map)
                    .bindPopup("<%=data.location%>")
                    .openPopup();

                window.addEventListener("load", () => {
                    map.invalidateSize();
                });



                // const map = L.map("map").setView([22.5726, 88.3639], 13);

                // L.tileLayer(
                //     "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                //     {
                //         maxZoom: 19
                //     }
                // ).addTo(map);
            </script>
</body>

</html>