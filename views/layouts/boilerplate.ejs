<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Airbnb Demo || Home Page:- view all listings</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
        integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/css/navfoot.css">
    <link rel="stylesheet" href="/css/index.css">
    <style>
        .quick-actions {
            width: 100%;
            padding: 0px 5vw;
            padding-bottom: 5px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            /* border: 1px solid black; */
        }

        .filters {
            /* border: 1px solid black; */
            width: 80%;
            padding: 15px 0px;
            display: flex;
            align-items: center;
            justify-content: space-around;
        }

        .filter {
            text-align: center;
            transition: 0.3s;
        }

        .filter p {
            margin: 0;
            opacity: 1;
            font-weight: 480;
        }

        .filter:hover {
            color: #d40e0e;
            opacity: 0.6;
            cursor: pointer;
        }

        .fi {
            font-size: 1.3rem;
        }

        .styling {
            height: 7vh;
            width: 16vw;
            padding: 0px 7px;
            text-align: center;
            align-content: center;
            border: 0.7px solid rgb(180, 180, 180);
            border-radius: 10px;
        }

        .form-switch {
            width: 90%;
        }

        .tax,
        .form-check-label {
            font-size: 1.2rem;
            cursor: pointer;
        }

        .hidden {
            display: none;
        }
    </style>
</head>

<body>
    <div class="header">
        <%- include("../includes/navbar") %>
    </div>
    <div class="quick-actions">
        <div class="filters">
            <div class="filter">
                <p class="fi"><i class="fa-solid fa-fire"></i></p>
                <p>Trending</p>
            </div>
            <div class="filter">
                <p class="fi"><i class="fa-solid fa-bed"></i></p>
                <p>Rooms</p>
            </div>
            <div class="filter">
                <p class="fi"><i class="fa-solid fa-city"></i></p>
                <p>Iconic Cities</p>
            </div>
            <div class="filter">
                <p class="fi"><i class="fa-solid fa-mountain"></i></p>
                <p>Mountains</p>
            </div>
            <div class="filter">
                <p class="fi"><i class="fa-brands fa-fort-awesome"></i></p>
                <p>Castle</p>
            </div>
            <div class="filter">
                <p class="fi"><i class="fa-solid fa-person-swimming"></i></p>
                <p>Pools</p>
            </div>
            <div class="filter">
                <p class="fi"><i class="fa-solid fa-tent"></i></p>
                <p>Camping</p>
            </div>
            <div class="filter">
                <p class="fi"><i class="fa-solid fa-cow"></i></p>
                <p>Farms</p>
            </div>
            <div class="filter">
                <p class="fi"><i class="fa-solid fa-igloo"></i></p>
                <p>Arctic</p>
            </div>
            <div class="filter">
                <p class="fi"><i class="fa-solid fa-place-of-worship"></i></p>
                <p>Temples</p>
            </div>
        </div>
        <div class="styling">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input tax" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label tax" for="switchCheckDefault">Price Including Tax</label>
            </div>
        </div>
    </div>
    <% if(error.length> 0) { %>
        <div class="error-msg">
            <h2>
                <%= error[0] %>
            </h2>
        </div>
        <% } %>
            <div class="container">
                <%- body %>
            </div>


            <div class="footer">
                <%- include("../includes/footer") %>
            </div>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                crossorigin="anonymous"></script>
            <script>
                const taxSwitch = document.querySelector("#switchCheckDefault");
                const taxInfo = document.querySelectorAll(".tax-info");
                taxSwitch.addEventListener("click", () => {
                    for (let item of taxInfo) {
                        item.classList.toggle("hidden");
                    }
                })
            </script>
</body>

</html>